# URL base que usa el navegador para llamar a la API.
# En desarrollo se deja en /api/v1 y Vite hace proxy al destino de API_PROXY_TARGET.
# En producción, la URL pública del backend: https://delivery-reportes-api.onrender.com/api/v1
VITE_API_URL=/api/v1

# Solo desarrollo: a dónde reenvía el proxy de Vite las llamadas a /api.
# API local: http://localhost:3000 · API deployada: https://delivery-reportes-api.onrender.com
API_PROXY_TARGET=http://localhost:3000
